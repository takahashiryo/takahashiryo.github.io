---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign paths = "|cv/" | split: "|" -%}
{%- for p in paths -%}
{%- assign suffix = p -%}
  <url><loc>{{ '/' | append: suffix | absolute_url }}</loc></url>
  <url><loc>{{ '/en/' | append: suffix | absolute_url }}</loc></url>
  <url><loc>{{ '/zh/' | append: suffix | absolute_url }}</loc></url>
{%- endfor %}
{%- comment %} 研究テーマの詳細ページ {% endcomment -%}
{%- for r in site.data.profile.research -%}
{%- assign suffix = "research/" | append: r.id | append: "/" -%}
  <url><loc>{{ '/' | append: suffix | absolute_url }}</loc></url>
  <url><loc>{{ '/en/' | append: suffix | absolute_url }}</loc></url>
  <url><loc>{{ '/zh/' | append: suffix | absolute_url }}</loc></url>
{%- endfor %}
</urlset>
